{
  "name": "Go Microservices Development",
  "dockerComposeFile": ["../docker-compose.yml", "../docker-compose.ms.yml", "docker-compose.yml"],
  "service": "devcontainer",
  "workspaceFolder": "/workspace",
  
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "zxh404.vscode-proto3",
        "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml",
        "streetsidesoftware.code-spell-checker",
        "eamodio.gitlens",
        "GitHub.copilot",
        "GitHub.copilot-chat"
      ],
      "settings": {
        "go.toolsManagement.checkForUpdates": "local",
        "go.useLanguageServer": true,
        "go.gopath": "/go"
      }
    }
  },

  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:1": {},
    "ghcr.io/devcontainers/features/go:1": {
      "version": "1.20"
    },
    "ghcr.io/dhoeric/features/google-cloud-cli:1": {},
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers-contrib/features/protoc:1": {}
  },

  "remoteUser": "vscode",
  
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/workspace/bin:/go/bin",
    "GOPATH": "/go"
  },

  "postCreateCommand": "go install google.golang.org/protobuf/cmd/protoc-gen-go@latest && go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@latest && go install github.com/envoyproxy/protoc-gen-validate@latest"
}